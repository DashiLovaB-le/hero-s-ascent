# Supabase (client + server) — VITE_* e SUPABASE_* devem ser iguais
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mentor (OpenRouter) — só no servidor
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Jobs / cron
CRON_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# URL pública do app (produção)
APP_PUBLIC_URL=https://sua-app.vercel.app

# Web Push (VAPID) — gerar com: npx web-push generate-vapid-keys
# Pública no client (VITE_) + privada só no servidor
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# OpenTelemetry — ativo em produção/preview. Ignorado em `vite dev` (trava o SSR do Vite).
# Local: use `npm run build && npm run preview` se precisar testar OTEL com o LGTM stack.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=hero-s-ascent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_DEPLOYMENT_ENVIRONMENT=development
# OTEL_DEBUG=true
