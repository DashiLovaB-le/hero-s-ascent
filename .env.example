# Supabase (client + server) — VITE_* e SUPABASE_* devem ser iguais
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mentor (OpenRouter) — só no servidor
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Jobs / cron
CRON_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Discord (DM notifications — espelho do Telegram)
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_USERNAME=Charlie

# URL pública do app (produção)
APP_PUBLIC_URL=https://sua-app.vercel.app

# Capacitor / FCM nativo (HTTP v1 — API legada desativada no Firebase)
# 1) android/app/google-services.json (não commitiar)
# 2) Firebase → Project settings → Service accounts → Generate new private key
# 3) No servidor, uma destas opções:
FIREBASE_PROJECT_ID=vproject-b1ac6
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# ou caminho local:
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# (FCM_SERVER_KEY legado NÃO funciona mais)

# TikTok Pixel (Ads) — opcional; default no código se omitido
# VITE_TIKTOK_PIXEL_ID=D9PIINBC77U97D5QAK00

# Web Push (VAPID) — gerar com: npx web-push generate-vapid-keys
# Em produção (Vercel): defina VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY (mesmo par) em Production e faça Redeploy.
# VITE_VAPID_PUBLIC_KEY é opcional (fallback no client em build).
# NÃO use o "certificado push da Web" do Firebase aqui — é outro sistema.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# OpenTelemetry — ativo em produção/preview. Ignorado em `vite dev` (trava o SSR do Vite).
# Local: use `npm run build && npm run preview` se precisar testar OTEL com o LGTM stack.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=hero-s-ascent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_DEPLOYMENT_ENVIRONMENT=development
# OTEL_DEBUG=true
