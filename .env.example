# Supabase (client + server) — VITE_* e SUPABASE_* devem ser iguais
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mentor (OpenRouter) — só no servidor
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Jobs / cron
CRON_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# URL pública do app (produção)
APP_PUBLIC_URL=https://sua-app.vercel.app
